@@ -0,0 +1,36 @@
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+
+repo = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(repo / 'manager/packaging'))
+import diagnose
+
+with tempfile.TemporaryDirectory() as directory:
+    root = Path(directory).resolve()
+    interpreter = root / 'python'
+    interpreter.write_bytes(Path(sys.executable).resolve().read_bytes())
+    configuration = subprocess.check_output([
+        sys.executable, str(repo / 'agent/connector/configure.py'),
+        '--python', str(interpreter), '--uid', '1000', '--gid', '1000',
+    ])
+    value = json.loads(configuration)
+    value['ceilings'].update(output_bytes=1024, memory_bytes=268435456)
+    (root / 'connector.json').write_text(json.dumps(value))
+    pin = value['python_sha256']
+    assert hashlib.sha256(interpreter.read_bytes()).hexdigest() == pin
+    print('valid configured connector diagnostic:', diagnose.runtime_hashes(root))
+    interpreter.write_bytes(b'changed interpreter bytes\n')
+    assert hashlib.sha256(interpreter.read_bytes()).hexdigest() != pin
+    try:
+        result = diagnose.runtime_hashes(root)
+    except ValueError as error:
+        print('modified connector refused:', error)
+    else:
+        print('modified configured connector diagnostic:', result)
+        print('FAIL: diagnostic accepted interpreter bytes that violate connector.json')
+        sys.exit(1)
