+use super::*;
+
+#[tokio::test]
+async fn audit_sol_large_valid_catalog_blocks_run_admission() {
+    let mut f = fixture();
+    let mut bindings = Vec::new();
+    for _ in 0..10 {
+        let connection = f.install(false);
+        let task = f.task(ConnectorOperation::Discover {
+            connection: connection.version,
+        });
+        let task = f.approve(task.id);
+        let id = ConnectorCallId::new();
+        f.reserve(&task, id);
+        assert!(f.state.dispatch_connector(id).unwrap().is_some());
+        let large_tool = McpTool {
+            name: "large".into(),
+            description: "A valid tool with a bounded documented input schema.".into(),
+            input_schema: json!({"type":"object","description":"x".repeat(7000)}),
+        };
+        let call = f
+            .state
+            .finish_connector(
+                id,
+                ConnectorOutcome::Finished {
+                    result: ConnectorResult::Catalog {
+                        tools: vec![large_tool],
+                    },
+                },
+            )
+            .unwrap();
+        assert!(matches!(
+            call.state,
+            ConnectorCallState::Resolved {
+                outcome: ConnectorOutcome::Finished { .. }
+            }
+        ));
+        f.finish_task(task.id);
+        let connection = f.state.load_connection(connection.id).unwrap();
+        bindings.push(f.grant(&connection, f.bot, &["large"]).tools.remove(0));
+    }
+    let mut request = input(&f, bindings[0].clone());
+    request.execution_policy.connectors.as_mut().unwrap().tools = bindings.clone();
+    let oversized = f.state.submit_run(token(), request).unwrap();
+    let healthy = f
+        .state
+        .submit_run(token(), input(&f, bindings[0].clone()))
+        .unwrap();
+    println!(
+        "accepted runs: large catalog {}, healthy {}",
+        oversized.request.id, healthy.request.id
+    );
+    let mut prepared = crate::manager::provider::PreparedChat::new(
+        &oversized.configuration.policy,
+        oversized.request.limits.max_output_tokens,
+        &[RunMessage::User {
+            content: oversized.request.prompt.clone(),
+        }],
+        Some(&oversized.request.execution_policy),
+    );
+    prepared.connector_tools(
+        f.state
+            .permitted_connector_catalog(
+                f.bot,
+                oversized
+                    .request
+                    .execution_policy
+                    .connectors
+                    .as_ref()
+                    .unwrap(),
+            )
+            .unwrap(),
+    );
+    println!(
+        "provider request bytes: {}, limit: {}",
+        prepared.encoded().len(),
+        crate::manager::provider::MAX_PROVIDER_REQUEST
+    );
+    for attempt in 1..=2 {
+        let result = f.state.claim_run_work(&HashSet::new(), true);
+        println!(
+            "claim attempt {attempt}: {}",
+            match result {
+                Err(ref error) => format!("Err({error:?})"),
+                Ok(Some(_)) => "Ok(Some(job))".into(),
+                Ok(None) => "Ok(None)".into(),
+            }
+        );
+        println!(
+            "healthy run phase: {:?}",
+            f.state.load_run(healthy.request.id).unwrap().summary.phase
+        );
+    }
+    let (sender, mut receiver) = mpsc::channel::<crate::manager::Job>(32);
+    let mut state = f.state;
+    let state_thread = std::thread::spawn(move || {
+        while let Some(job) = receiver.blocking_recv() {
+            job(&mut state);
+        }
+    });
+    let queue = crate::manager::Queue {
+        sender,
+        credential: std::sync::Arc::new(tokio::sync::Semaphore::new(1)),
+    };
+    let control = std::sync::Arc::new(crate::manager::inference::InferenceControl::default());
+    let stop = control.stop.clone();
+    let job = crate::manager::runs::start(
+        queue.clone(),
+        Provider::fixture("http://127.0.0.1:9".into()),
+        control.clone(),
+        stop,
+    );
+    let result = tokio::time::timeout(std::time::Duration::from_secs(2), job)
+        .await
+        .unwrap()
+        .unwrap();
+    let stopping = control.stopping.load(std::sync::atomic::Ordering::Acquire);
+    println!("production run pump result: {result:?}");
+    println!("shared inference stopping: {stopping}");
+    drop(queue);
+    state_thread.join().unwrap();
+    assert!(
+        !stopping,
+        "a valid connector catalog must not stop shared inference for every run"
+    );
+}
+
+#[test]
+fn audit_sol_connection_summaries_fit_snapshot_increment() {
+    let mut f = fixture();
+    for _ in 0..MAX_CONNECTIONS {
+        f.state
+            .install_connection(
+                token(),
+                InstallConnection {
+                    id: ConnectionId::new(),
+                    label: "\"".repeat(100),
+                    transport: ConnectionTransport::RemoteHttp {
+                        endpoint: "https://example.com/mcp".into(),
+                    },
+                },
+            )
+            .unwrap();
+    }
+    let EventReplay::Snapshot { state, .. } = f.state.resume(token(), 0, 64).unwrap() else {
+        panic!("snapshot");
+    };
+    assert_eq!(state.connections.len(), MAX_CONNECTIONS);
+    let serialized = serde_json::to_vec(&state.connections).unwrap().len();
+    let allocation = state.connections.capacity() * std::mem::size_of::<ConnectionSummary>()
+        + state
+            .connections
+            .iter()
+            .map(|c| c.label.capacity())
+            .sum::<usize>();
+    println!(
+        "32 maximally escaped connection labels use {serialized} serialized bytes and {allocation} allocated bytes"
+    );
+    assert!(serialized <= MAX_CONNECTIONS * 1024);
+    assert!(allocation <= MAX_CONNECTIONS * 2048);
+}
