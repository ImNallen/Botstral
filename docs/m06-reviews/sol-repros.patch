+use botstral_agent::{Config, transport};
+use sha2::{Digest, Sha256};
+use std::{fs, os::unix::fs::PermissionsExt};
+
+#[tokio::test]
+async fn audit_sol_worker_refuses_the_interpreter_ignored_by_diagnostics() {
+    let temporary = tempfile::tempdir().unwrap();
+    let root = temporary.path();
+    fs::set_permissions(root, fs::Permissions::from_mode(0o700)).unwrap();
+    let interpreter = root.join("python");
+    fs::write(&interpreter, b"pinned interpreter bytes").unwrap();
+    let digest = format!("{:x}", Sha256::digest(fs::read(&interpreter).unwrap()));
+    let mut identity = Sha256::new();
+    identity.update(include_bytes!("../connector/runtime.py"));
+    identity.update(digest.as_bytes());
+    let configuration = serde_json::json!({
+        "python": interpreter, "python_sha256": digest,
+        "runtime": format!("{:x}", identity.finalize()),
+        "account": {"uid": unsafe { libc::geteuid() }, "gid": unsafe { libc::getegid() }},
+        "ceilings": {"runtime_seconds": 60, "output_bytes": 1024, "processes": 32, "memory_bytes": 268435456}
+    });
+    fs::write(root.join("connector.json"), configuration.to_string()).unwrap();
+    fs::set_permissions(
+        root.join("connector.json"),
+        fs::Permissions::from_mode(0o600),
+    )
+    .unwrap();
+    let config = Config {
+        manager: "wss://127.0.0.1:9".into(),
+        manager_ca: root.join("absent-ca"),
+        client_cert: root.join("absent-cert"),
+        client_key: root.join("absent-key"),
+    };
+    let initial = transport::run(config.clone(), root, false, true)
+        .await
+        .unwrap_err();
+    println!(
+        "valid interpreter passes runtime verification, then fails on the intentionally absent TLS file: {initial}"
+    );
+    assert_ne!(initial.to_string(), "connector runtime changed");
+    for file in fs::read_dir(root).unwrap() {
+        let path = file.unwrap().path();
+        if path.is_file() {
+            fs::set_permissions(path, fs::Permissions::from_mode(0o600)).unwrap();
+        }
+    }
+    fs::write(interpreter, b"changed interpreter bytes").unwrap();
+    let changed = transport::run(config, root, false, true).await.unwrap_err();
+    println!("production worker startup after interpreter mutation: {changed}");
+    assert_eq!(changed.to_string(), "connector runtime changed");
+}
+
+#[tokio::test]
+async fn audit_sol_documented_generator_configuration_is_usable() {
+    let temporary = tempfile::tempdir().unwrap();
+    let root = temporary.path();
+    fs::set_permissions(root, fs::Permissions::from_mode(0o700)).unwrap();
+    let script = std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join("connector/configure.py");
+    let python = std::process::Command::new("python3")
+        .args(["-c", "import sys; print(sys.executable)"])
+        .output()
+        .unwrap();
+    assert!(python.status.success());
+    let configured = std::process::Command::new("python3")
+        .arg(script)
+        .arg("--python")
+        .arg(String::from_utf8(python.stdout).unwrap().trim())
+        .output()
+        .unwrap();
+    assert!(configured.status.success());
+    let value: serde_json::Value = serde_json::from_slice(&configured.stdout).unwrap();
+    println!(
+        "documented configure.py output ceilings: {}",
+        value["ceilings"]
+    );
+    fs::write(root.join("connector.json"), configured.stdout).unwrap();
+    fs::set_permissions(
+        root.join("connector.json"),
+        fs::Permissions::from_mode(0o600),
+    )
+    .unwrap();
+    let config = Config {
+        manager: "wss://127.0.0.1:9".into(),
+        manager_ca: root.join("absent-ca"),
+        client_cert: root.join("absent-cert"),
+        client_key: root.join("absent-key"),
+    };
+    let result = transport::run(config, root, false, true).await.unwrap_err();
+    println!("production worker loading documented configuration: {result}");
+    assert_ne!(
+        result.to_string(),
+        "InvalidMessage",
+        "configure.py must generate resource ceilings accepted by the production worker"
+    );
+}
