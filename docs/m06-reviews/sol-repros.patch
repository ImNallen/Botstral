+import csv
+import hashlib
+import json
+from pathlib import Path
+import re
+import subprocess
+
+root = Path(__file__).resolve().parents[1]
+head = '48bf1bb2cc917499a6889f24519426f5f0666755'
+manifest = json.loads((root / 'docs/evidence/m06-integrated-84b6d2fb/source-files.json').read_text())
+changed = []
+for name, expected in manifest.items():
+    value = subprocess.run(['git', 'show', head + ':' + name], cwd=root, capture_output=True)
+    if value.returncode or hashlib.sha256(value.stdout).hexdigest() != expected:
+        changed.append(name)
+print('Exact-head source manifest entries:', len(manifest))
+print('Differences:', json.dumps(changed))
+assert set(changed) == {'docs/m06-architecture.md', 'docs/m06-connectors.md', 'docs/m06-decisions.tsv', 'docs/m06-recovery-acceptance.md'}
+for row in csv.DictReader((root / 'docs/m06-decisions.tsv').open(), delimiter='\t'):
+    print('Decision', row['phase'], row['ts'])
+    for value in row['evidence'].split(';'):
+        value = value.strip()
+        if re.fullmatch('[0-9a-f]{7,40}', value):
+            result = subprocess.check_output(['git', 'cat-file', '-t', value], cwd=root, text=True).strip()
+            assert result == 'commit'
+            print('  Commit exists', value)
+            continue
+        path = value.split(':')[0]
+        file = Path(path) if path.startswith('/') else root / path
+        assert file.is_file(), value
+        print('  Evidence exists', path, file.stat().st_size)
+        if file.suffix == '.log':
+            lines = [line for line in file.read_text().splitlines() if re.search(r'test result:|^Ran |^OK$|^FAILED|^Verified', line)]
+            for line in lines:
+                print('   ', line)
+report = json.loads((root / 'docs/evidence/m06-integrated-84b6d2fb/report.json').read_text())
+print('Integrated gates:', report['gates'])
+print('Integrated checks:', [check['name'] for check in report['checks']])
+print('Cleanup errors:', report['cleanup_errors'])
+print('Fixtures retained:', report['fixtures_retained'])
+assert report['passed'] and not report['cleanup_errors'] and not report['fixtures_retained']
