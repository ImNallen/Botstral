ARG SEALED_IMAGE=botstral-p06-linux:8aaf445c
FROM --platform=linux/amd64 ${SEALED_IMAGE} AS sealed
FROM ubuntu:24.04
ENV container=docker
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends systemd systemd-sysv dbus-user-session python3 python3-websocket libnss3-tools ca-certificates openssl \
    && systemd --version | head -1 | grep '^systemd 255 ' \
    && useradd --uid 10001 --create-home --shell /bin/bash p06 \
    && install -d /var/lib/systemd/linger \
    && touch /var/lib/systemd/linger/p06 \
    && ln -s /dev/null /etc/systemd/system/systemd-binfmt.service \
    && ln -s /dev/null /etc/systemd/system/systemd-sysctl.service \
    && ln -s /dev/null /etc/systemd/system/systemd-modules-load.service \
    && ln -s /usr/lib/systemd/system/user@.service /etc/systemd/system/multi-user.target.wants/user@10001.service
COPY --from=sealed /opt/p06-runtime /opt/p06-runtime
COPY --from=sealed /usr/lib/x86_64-linux-gnu /usr/lib/x86_64-linux-gnu
COPY --from=sealed /usr/lib64 /usr/lib64
RUN ln -s usr/lib64 /lib64
COPY --from=sealed /usr/share/fonts /usr/share/fonts
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
